// ClothSeeker database schema (single brand — no sellers or stores).
// The connection URL lives in prisma.config.ts (Prisma 7), not here.
// Every table has RLS enabled with no policies (see migrations): only server-side Prisma can access data.
// Money is stored as integer minor units (poisha); the store currency is BDT (lib/money.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

/// One row per Supabase auth user. `id` equals `auth.users.id`.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart          Cart?
  orders        Order[]
  designs       Design[]
  aiRounds      AIRound[]
  aiJobs        AIJob[]
  tryOnPhotos   TryOnPhoto[]
  tryOnResults  TryOnResult[]
  aiLimitHits   AiLimitHit[]
  quoteRequests QuoteRequest[]
  reviews       Review[]
  disputes      Dispute[]
  flaggedItems  FlaggedItem[]
  auditLogs     AuditLog[]

  @@map("users")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  description String
  categoryId  String        @map("category_id") @db.Uuid
  status      ProductStatus @default(DRAFT)
  /// Storage keys in the product-media bucket (uploads arrive in Phase 2).
  imageKeys   String[]      @default([]) @map("image_keys")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants Variant[]
  template CustomizationTemplate?
  designs  Design[]
  reviews  Review[]
  tryOns   TryOnResult[]

  @@index([status, categoryId])
  @@map("products")
}

model Variant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String   @unique
  size       Size
  colorName  String   @map("color_name")
  colorHex   String   @map("color_hex")
  priceMinor Int      @map("price_minor")
  stock      Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, colorName])
  @@index([productId, isActive])
  @@map("variants")
}

/// Customization rules for one product. `config` is validated by types/template.ts.
model CustomizationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  version   Int      @default(1)
  config    Json
  aiEnabled Boolean  @default(false) @map("ai_enabled")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  designs Design[]

  @@map("customization_templates")
}

// ─── Designs and AI ───────────────────────────────────────────────────────────

enum DesignStartedFrom {
  SHOP
  PHOTO
  DESCRIPTION
}

enum DesignStatus {
  DRAFT
  SAVED
  ORDERED
}

model Design {
  id                String            @id @default(uuid()) @db.Uuid
  customerId        String            @map("customer_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  templateId        String?           @map("template_id") @db.Uuid
  templateVersion   Int?              @map("template_version")
  /// Versioned DesignSpec (types/design-spec.ts, Phase 3). Never trusted from the client.
  spec              Json
  startedFrom       DesignStartedFrom @default(SHOP) @map("started_from")
  referencePhotoKey String?           @map("reference_photo_key")
  previewKey        String?           @map("preview_key")
  status            DesignStatus      @default(DRAFT)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  customer      User                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  template      CustomizationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  aiRounds      AIRound[]
  tryOnResults  TryOnResult[]
  quoteRequests QuoteRequest[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([customerId, updatedAt])
  @@map("designs")
}

model AIRound {
  id             String   @id @default(uuid()) @db.Uuid
  designId       String   @map("design_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  instruction    String
  attachmentKeys String[] @default([]) @map("attachment_keys")
  /// Storage keys of the rendered option previews (design-assets, up to 4 per round).
  optionKeys     String[] @default([]) @map("option_keys")
  /// The candidate designs, aligned with optionKeys: [{ title, summary, spec, motifKey }] (lib/ai/rounds.ts).
  options        Json     @default("[]")
  chosenIndex    Int?     @map("chosen_index")
  inputHash      String   @map("input_hash")
  /// "Generate again" bumps this so the same instruction gets fresh results instead of the cache.
  generation     Int      @default(0)
  /// The job that produced this round; a cache hit hands this job back to the client.
  jobId          String   @unique @map("job_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      AIJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([designId, createdAt])
  @@index([customerId, inputHash])
  @@map("ai_rounds")
}

enum AIJobType {
  DESIGN_ROUND
  DRESS_MATCH
  TRY_ON
}

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Postgres-backed job queue processed by the worker (Phase 6+).
model AIJob {
  id          String      @id @default(uuid()) @db.Uuid
  type        AIJobType
  status      AIJobStatus @default(QUEUED)
  customerId  String      @map("customer_id") @db.Uuid
  payload     Json
  /// SUCCEEDED design rounds: { roundId }.
  result      Json?
  /// Internal detail of the last failure (error name/code). Never shown to customers.
  error       String?
  /// Customer-safe failure reason, see lib/ai/errors.ts.
  errorCode   String?     @map("error_code")
  attempts    Int         @default(0)
  maxAttempts Int         @default(3) @map("max_attempts")
  inputHash   String      @map("input_hash")
  runAfter    DateTime    @default(now()) @map("run_after")
  lockedAt    DateTime?   @map("locked_at")
  lockedBy    String?     @map("locked_by")
  startedAt   DateTime?   @map("started_at")
  finishedAt  DateTime?   @map("finished_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  round    AIRound?
  tryOn    TryOnResult?

  @@index([status, runAfter])
  @@index([customerId, createdAt])
  @@index([inputHash])
  @@map("ai_jobs")
}

model TryOnPhoto {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  /// tryon-private key; the file is removed when the photo is deleted (the row stays for the audit trail).
  storageKey String    @map("storage_key")
  /// When the customer agreed to the try-on terms for this photo.
  consentAt  DateTime  @map("consent_at")
  /// Saved photos are kept until the customer deletes them; unsaved ones are deleted after 24 hours.
  saved      Boolean   @default(false)
  /// When the photo passed the try-on photo check (one person, facing forward, good light, body visible).
  checkedAt  DateTime? @map("checked_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  results  TryOnResult[]

  @@index([saved, createdAt])
  @@index([customerId])
  @@map("try_on_photos")
}

model TryOnResult {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  photoId     String    @map("photo_id") @db.Uuid
  /// What was tried on: a design (snapshot signature in garmentHash) or a ready-made product.
  designId    String?   @map("design_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  /// Signature of the garment as tried on; the UI compares it to detect "your design changed".
  garmentHash String    @map("garment_hash")
  inputHash   String    @map("input_hash")
  /// tryon-private key of the result image (removed when deleted).
  resultKey   String    @map("result_key")
  saved       Boolean   @default(false)
  jobId       String    @unique @map("job_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photo    TryOnPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  design   Design?    @relation(fields: [designId], references: [id], onDelete: SetNull)
  product  Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  job      AIJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([saved, createdAt])
  @@index([customerId, createdAt])
  @@index([customerId, inputHash])
  @@map("try_on_results")
}

/// REQUESTED → QUOTED (team priced it) or DECLINED (team) or EXPIRED (no reply in 24 h)
/// QUOTED → ACCEPTED (paid) or WITHDRAWN (customer) or EXPIRED (not paid within 7 days)
enum QuoteStatus {
  REQUESTED
  QUOTED
  DECLINED
  ACCEPTED
  EXPIRED
  WITHDRAWN
}

model QuoteRequest {
  id                String      @id @default(uuid()) @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  designId          String      @map("design_id") @db.Uuid
  /// The customer's notes for the tailors (what needs special tailoring).
  notes             String      @default("")
  /// The design as it was when the quote was requested: later edits don't change what was quoted.
  specSnapshot      Json        @map("spec_snapshot")
  /// Preview rendered for this quote (design-assets, `{customerId}/quotes/`).
  previewKey        String?     @map("preview_key")
  /// The dress photo the design was started from (design-assets `{customerId}/references/`).
  referencePhotoKey String?     @map("reference_photo_key")
  status            QuoteStatus @default(REQUESTED)
  priceMinor        Int?        @map("price_minor")
  responseNote      String?     @map("response_note")
  /// The team must reply by this time (24 hours after the request).
  respondBy         DateTime    @map("respond_by")
  respondedAt       DateTime?   @map("responded_at")
  /// A price is valid until this time (7 days after it was sent).
  expiresAt         DateTime?   @map("expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  design     Design      @relation(fields: [designId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([status, respondBy])
  @@index([status, expiresAt])
  @@index([customerId, createdAt])
  @@map("quote_requests")
}

// ─── Cart and orders ──────────────────────────────────────────────────────────

enum ItemKind {
  READY_MADE
  CUSTOM_DESIGN
  QUOTE
}

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  kind           ItemKind
  variantId      String?  @map("variant_id") @db.Uuid
  designId       String?  @map("design_id") @db.Uuid
  quoteRequestId String?  @map("quote_request_id") @db.Uuid
  quantity       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant      Variant?      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  design       Design?       @relation(fields: [designId], references: [id], onDelete: Cascade)
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum DeliveryZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  number         String      @unique
  customerId     String      @map("customer_id") @db.Uuid
  status         OrderStatus @default(PENDING_PAYMENT)
  totalMinor     Int         @map("total_minor")
  currency       String      @default("BDT")
  /// Client retries with the same key return the existing order instead of creating a duplicate.
  idempotencyKey String      @unique @map("idempotency_key")
  paymentRef     String?     @unique @map("payment_ref")
  paidAt         DateTime?   @map("paid_at")
  /// Pending orders hold stock until this time; then they are cancelled (lib/orders/expiry.ts).
  expiresAt      DateTime?   @map("expires_at")

  // Totals: subtotal + delivery fee = totalMinor. Computed on the server at checkout.
  subtotalMinor    Int           @default(0) @map("subtotal_minor")
  deliveryFeeMinor Int           @default(0) @map("delivery_fee_minor")
  deliveryZone     DeliveryZone? @map("delivery_zone")

  // Shipping snapshot: the minimum needed to deliver (nullable only for pre-Phase-4 orders).
  shippingName       String? @map("shipping_name")
  shippingPhone      String? @map("shipping_phone")
  shippingLine1      String? @map("shipping_line1")
  shippingLine2      String? @map("shipping_line2")
  shippingCity       String? @map("shipping_city")
  shippingPostalCode String? @map("shipping_postal_code")
  /// Optional note for the tailors (max 300 chars); printed on the production spec sheet.
  customerNote       String? @map("customer_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer User         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]
  refunds  Refund[]

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

/// Fulfilment lifecycle of one order line. Quote states live on QuoteRequest.
/// Legal transitions are enforced in one domain module (Phase 4).
enum OrderItemStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_ACCEPTANCE
  ACCEPTED
  IN_PRODUCTION
  QC_SUBMITTED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  DISPUTED
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  kind           ItemKind
  variantId      String?         @map("variant_id") @db.Uuid
  designId       String?         @map("design_id") @db.Uuid
  quoteRequestId String?         @map("quote_request_id") @db.Uuid
  // Snapshots taken at payment time so later catalog edits never change a past order.
  productName    String          @map("product_name")
  size           Size
  colorName      String?         @map("color_name")
  unitPriceMinor Int             @map("unit_price_minor")
  quantity       Int
  designSpec     Json?           @map("design_spec")
  /// Custom items: approved preview and 300 DPI print files frozen at checkout (design-assets keys).
  previewKey     String?         @map("preview_key")
  printFiles     Json?           @map("print_files")
  status         OrderItemStatus @default(PENDING_PAYMENT)
  acceptBy       DateTime?       @map("accept_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      Variant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  design       Design?       @relation(fields: [designId], references: [id], onDelete: SetNull)
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  shipment     Shipment?
  review       Review?
  disputes     Dispute[]
  events       OrderEvent[]
  qcPhotos     QcPhoto[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// One payment attempt with an external (or mock) gateway.
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  provider    String
  providerRef String        @unique @map("provider_ref")
  status      PaymentStatus @default(PENDING)
  amountMinor Int           @map("amount_minor")
  currency    String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

/// Webhook events already processed. The unique eventId makes webhook handling idempotent.
model PaymentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id")
  paymentId String   @map("payment_id") @db.Uuid
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_events")
}

enum ActorType {
  SYSTEM
  CUSTOMER
  ADMIN
  COURIER
}

/// Order timeline: every status change (and notable note) of an order or one of its items.
model OrderEvent {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  orderItemId String?   @map("order_item_id") @db.Uuid
  fromStatus  String?   @map("from_status")
  toStatus    String    @map("to_status")
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id") @db.Uuid
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

enum ShipmentStatus {
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderItemId    String         @unique @map("order_item_id") @db.Uuid
  carrier        String
  trackingNumber String?        @unique @map("tracking_number")
  status         ShipmentStatus @default(LABEL_CREATED)
  shippedAt      DateTime?      @map("shipped_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  orderItem     OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  courierEvents CourierEvent[]

  @@map("shipments")
}

/// Courier webhook events already processed (dedupe) — also the customer's tracking history.
model CourierEvent {
  id         String         @id @default(uuid()) @db.Uuid
  eventId    String         @unique @map("event_id")
  shipmentId String         @map("shipment_id") @db.Uuid
  status     ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@map("courier_events")
}

enum QcSide {
  FRONT
  BACK
}

/// Quality-check evidence for a made-to-order item (private qc-photos bucket). History is kept.
model QcPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  orderItemId  String   @map("order_item_id") @db.Uuid
  side         QcSide
  storageKey   String   @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId, createdAt])
  @@map("qc_photos")
}

enum RefundKind {
  ITEM
  DELIVERY_FEE
}

enum RefundStatus {
  PENDING
  SUCCEEDED
}

/// Money returned to the customer. `uniqueKey` ("item:<id>" / "delivery:<paymentId>") guarantees
/// each item and each delivery fee is refunded at most once.
model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  uniqueKey   String       @unique @map("unique_key")
  paymentId   String       @map("payment_id") @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  orderItemId String?      @map("order_item_id") @db.Uuid
  kind        RefundKind
  amountMinor Int          @map("amount_minor")
  reason      String
  status      RefundStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  payment   Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
  @@map("refunds")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  rating      Int
  body        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer  User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("reviews")
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUND
  RESOLVED_REJECTED
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  orderItemId String        @map("order_item_id") @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  reason      String
  /// Customer evidence photos (design-assets `{customerId}/disputes/`), up to 3.
  photoKeys   String[]      @default([]) @map("photo_keys")
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  customer  User      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orderItemId])
  @@map("disputes")
}

// ─── Moderation and audit ─────────────────────────────────────────────────────

enum FlagKind {
  BRAND_LOGO
}

enum FlagStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

model FlaggedItem {
  id         String     @id @default(uuid()) @db.Uuid
  kind       FlagKind
  status     FlagStatus @default(OPEN)
  customerId String?    @map("customer_id") @db.Uuid
  aiJobId    String?    @map("ai_job_id") @db.Uuid
  storageKey String?    @map("storage_key")
  reason     String
  /// The team's note when confirming or dismissing the flag.
  reviewNote String?    @map("review_note")
  reviewedAt DateTime?  @map("reviewed_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  customer User? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("flagged_items")
}

/// Append-only record of sensitive actions. Never store secrets or personal data in metadata.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// Who acted, kept even if the account is later deleted: ADMIN, CUSTOMER or SYSTEM.
  actorRole  String?  @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─── Operations ───────────────────────────────────────────────────────────────

enum AiLimitFeature {
  DESIGN_ROUND
  TRY_ON
  SUBMISSIONS
}

/// A customer was refused because a daily AI limit was reached (for the AI metrics page).
model AiLimitHit {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  feature    AiLimitFeature
  createdAt  DateTime       @default(now()) @map("created_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("ai_limit_hits")
}

/// Last sign of life of each worker process, with the providers it runs (for the AI metrics page).
model WorkerHeartbeat {
  workerId   String   @id @map("worker_id")
  planner    String
  image      String
  tryOn      String   @map("try_on")
  startedAt  DateTime @map("started_at")
  lastSeenAt DateTime @map("last_seen_at")

  @@index([lastSeenAt])
  @@map("worker_heartbeats")
}
