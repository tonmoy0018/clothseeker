# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.nosync/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only the placeholder template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client
/lib/generated/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# supabase local state
/supabase/.temp/
/supabase/.branches/

# on-device vision files (models from Hugging Face, ONNX Runtime): pnpm vision:fetch
/public/vision/

# Python caches (worker/local-tryon)
__pycache__/
*.pyc
