# ClothSeeker environment variables.
# Copy to .env.local (never committed) and fill in. For local development, generate it instead:
#   pnpm db:start && pnpm env:local
# Validated at runtime by lib/env/schema.ts — the app/worker will tell you which variable is wrong.

# ── Client-safe (inlined into the browser bundle) ────────────────────────────
# Base URL of the Next.js app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase API URL. Local: "API_URL" from `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
# Supabase publishable (anon) key. Local: "PUBLISHABLE_KEY". Safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# Supabase secret (service role) key. Local: "SECRET_KEY". Bypasses RLS — server and worker only.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Runtime Postgres connection used by Prisma. Local: "DB_URL".
# Hosted Supabase: the pooled (port 6543, transaction mode) connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
# Direct Postgres connection used by `prisma migrate`. Local: same as DATABASE_URL.
# Hosted Supabase: the direct / session (port 5432) connection string.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# Payment provider ("mock" is the only one so far) and the secret that signs its webhooks.
# Generate with: openssl rand -hex 32
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# Signs mock courier status webhooks. Generate with: openssl rand -hex 32
MOCK_COURIER_WEBHOOK_SECRET=replace_with_at_least_32_random_characters

# ── Local development and tests ─────────────────────────────────────────────
# Integration tests use their own database; its name must end in _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/clothseeker_test
# Password given to the seeded demo accounts. Local only; the seed refuses remote databases.
SEED_DEMO_PASSWORD=clothseeker-demo

# ── Worker (optional) ────────────────────────────────────────────────────────
# How often the worker polls the job queue, in ms (500–60000, default 5000).
# WORKER_POLL_INTERVAL_MS=5000

# ── AI design box (Phase 6) — worker only; the app never calls an AI provider ──
# The fakes need no keys and are deterministic (default for development, tests and CI).
# See docs/developers/ai-pipelines.md for switching to the real providers.
# PLANNER_PROVIDER=fake          # fake | gemini
# IMAGE_PROVIDER=fake            # fake | cloudflare
# GEMINI_API_KEY=                # required when PLANNER_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash   # tried in order when a model is busy or retired
# CLOUDFLARE_ACCOUNT_ID=         # required when IMAGE_PROVIDER=cloudflare (32 hex chars)
# CLOUDFLARE_API_TOKEN=          # required when IMAGE_PROVIDER=cloudflare (Workers AI read/edit)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# AI_FAKE_DELAY_MS=1500          # artificial latency of the fakes, so loading states are visible
# AI_JOB_TIMEOUT_MS=120000       # hard limit for one attempt at an AI job
# WORKER_HEALTH_PORT=            # if set, the worker answers GET /health on 127.0.0.1 (local E2E)

# ── Virtual try-on (Phase 7) — worker only ───────────────────────────────────
# TRYON_PROVIDER=fake            # fake | huggingface (free public Spaces; rough preview, small daily GPU allowance)
# HF_TOKEN=                      # optional free Hugging Face account token (hf_…): raises the shared allowance
# TRYON_SPACES=levihsu/OOTDiffusion,franciszzj/Leffa   # tried in order
# TRYON_TIMEOUT_MS=240000        # limit for one try-on attempt

# ── Later phases (not used yet — added and validated when the phase lands) ───
# Phase 5/7 — shared secret for scheduled cleanup / timeout endpoints
# CRON_SECRET=
